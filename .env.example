# SpendSense Environment Configuration Template
# Copy this file to .env and adjust variables as needed.

SPENDSENSE_ENV=development
LOG_LEVEL=INFO

# Application Paths
CONFIG_PATH=configs/default.yaml
CATEGORIES_PATH=configs/categories.yaml
DATA_DIR=data
MODEL_DIR=models
DATABASE_URL=sqlite:///data/spendsense.db

# API Service Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=true

# Streamlit Dashboard Configuration
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8501

# MLflow Tracking
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=spendsense-categorization

